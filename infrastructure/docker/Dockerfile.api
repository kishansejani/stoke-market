FROM node:20-alpine AS builder

WORKDIR /app

# Copy root manifest and workspaces
COPY package*.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

RUN npm install
RUN npm --workspace=@stock-market/shared-types run build
RUN npm --workspace=@stock-market/validation run build
RUN npm --workspace=@stock-market/design-tokens run build
RUN npm --workspace=@stock-market/shared-utils run build
RUN npm --workspace=@stock-market/api-client run build

WORKDIR /app/apps/api
RUN npx prisma generate
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=5000

COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/api ./apps/api

WORKDIR /app/apps/api
EXPOSE 5000

CMD ["node", "dist/server.js"]

