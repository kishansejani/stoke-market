FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
COPY packages/ ./packages/
COPY apps/web/ ./apps/web/

RUN npm install
RUN npm --workspace=@stock-market/shared-types run build
RUN npm --workspace=@stock-market/validation run build
RUN npm --workspace=@stock-market/design-tokens run build
RUN npm --workspace=@stock-market/shared-utils run build
RUN npm --workspace=@stock-market/api-client run build

WORKDIR /app/apps/web
RUN npm run build

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infrastructure/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

