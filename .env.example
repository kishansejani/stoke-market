# ========================================================
# GLOBAL STOCK MARKET PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
NODE_ENV=development
PORT=5000
API_HOST=localhost
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL or SQLite for zero-setup local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_market?schema=public"

# Redis Cache & PubSub (leave empty or use memory fallback for standalone dev)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_ACCESS_SECRET="dev_access_secret_super_secure_key_financial_terminal_2026_xyz"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_key_financial_terminal_2026_xyz"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
LICENSE_HMAC_SECRET="dev_license_hmac_secret_crypto_seed_2026_veritas"

# Market Data Providers (Optional - Leave blank to use Built-in Mock Simulator)
# Mock data is clearly flagged with isSimulated=true
MARKET_DATA_PROVIDER="MOCK"
POLYGON_API_KEY=""
FINNHUB_API_KEY=""
ALPHAVANTAGE_API_KEY=""
NSE_FEED_API_KEY=""
NSE_FEED_URL=""

# Payment Gateways (Optional for dev sandbox)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Mobile / Push Notifications
EXPO_ACCESS_TOKEN=""
