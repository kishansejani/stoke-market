{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:packages && npm --workspace=@stock-market/web run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
